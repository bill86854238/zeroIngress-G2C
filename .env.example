# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Your Gmail address — used to filter out emails you sent yourself
MY_EMAIL=your_gmail@gmail.com

# Optional: Brave Search API key for enriching hotel check-in times and addresses.
# Get a free key (2000 req/month) at https://brave.com/search/api/
# Leave blank or omit to disable enrichment entirely.
BRAVE_API_KEY=

# Sync target: google (default) or caldav. Can also be overridden with --target=caldav flag.
SYNC_TARGET=google

# Optional: Synology CalDAV target
CALDAV_URL=http://<NAS_IP>:5000/caldav/<username>/
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_CALENDAR=My Calendar
